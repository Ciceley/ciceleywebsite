# Copy this file to `.env` and fill in your values.
# Your Notion integration token: https://www.notion.so/my-integrations
NOTION_API_KEY=

# The id of the Notion database you write posts in.
# Open the database as a full page; the URL looks like:
#   https://www.notion.so/<workspace>/<THIS_32_CHAR_ID>?v=...
NOTION_DATABASE_ID=

# Optional: override the expected property names in your database.
#NOTION_TITLE_PROP=Name
#NOTION_SLUG_PROP=Slug
#NOTION_DATE_PROP=Date
#NOTION_DESC_PROP=Description
#NOTION_TAGS_PROP=Tags
#NOTION_CATS_PROP=Categories
#NOTION_STATUS_PROP=Status
