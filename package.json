{
  "name": "ciceleywebsite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ciceley — personal writing site (Hugo + Stack), content synced from Notion.",
  "scripts": {
    "sync": "node scripts/notion-sync.mjs",
    "sync:pr": "bash scripts/sync-pr.sh",
    "dev": "hugo server -D --disableFastRender",
    "build": "hugo --minify"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "dotenv": "^16.4.5",
    "notion-to-md": "^3.1.9"
  }
}
